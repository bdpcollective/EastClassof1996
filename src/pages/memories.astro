---

<BaseLayout
  title="Memories | Lincoln East High School Class of 1996"
  description="View photos and memories from the Lincoln East High School Class of 1996. Share your own memories and reconnect with classmates."
>
  <Header />
  <Banner />

  <main id="main-content">
    <section class="memories-page ambient-bg">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">MEMORIES</h2>
          <div class="title-accent"></div>
        </div>
        <div class="memories-gallery">
          {photos.map((photo, i) => (
            <div class="memory-card" data-lightbox="gallery" data-full-src={`/images/lightbox/${photo.name}.webp`} tabindex="0" role="button" aria-label={`View photo: ${photo.label}`}>
              <div class="memory-image-wrapper">
                <img src={`/images/thumbs/${photo.name}.webp`} alt="Class of 1996 reunion photo" width="700" height="700" decoding="async" loading={i < 6 ? 'eager' : 'lazy'} />
                <div class="overlay">
                  <svg class="zoom-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo lightbox">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-container">
      <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
      <button class="lightbox-prev" aria-label="Previous photo">&#8249;</button>
      <button class="lightbox-next" aria-label="Next photo">&#8250;</button>
      <div class="lightbox-content">
        <img id="lightbox-image" src="" alt="" />
        <div class="lightbox-info">
          <p id="lightbox-caption"></p>
          <div class="lightbox-counter" aria-live="polite">
            <span id="lightbox-current">1</span> / <span id="lightbox-total">{photos.length}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Footer />

  <script>
    function initLightbox() {
      const memoryCards = document.querySelectorAll('.memory-card');
      const lightbox = document.getElementById('lightbox');
      const lightboxImage = document.getElementById('lightbox-image');
      const lightboxClose = document.querySelector('.lightbox-close');
      const lightboxPrev = document.querySelector('.lightbox-prev');
      const lightboxNext = document.querySelector('.lightbox-next');
      const lightboxBackdrop = document.querySelector('.lightbox-backdrop');
      const currentCounter = document.getElementById('lightbox-current');
      const totalCounter = document.getElementById('lightbox-total');

      let currentImageIndex = 0;
      const cards = Array.from(memoryCards);
      if (totalCounter) totalCounter.textContent = cards.length;

      function openLightbox(index) {
        currentImageIndex = index;
        const card = cards[currentImageIndex];
        lightboxImage.src = card.dataset.fullSrc;
        lightboxImage.alt = card.querySelector('img').alt;
        if (currentCounter) currentCounter.textContent = currentImageIndex + 1;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
        lightboxClose?.focus();
      }

      function closeLightbox() {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
        if (lastFocusedCard) lastFocusedCard.focus();
      }

      function showPrevImage() {
        currentImageIndex = currentImageIndex === 0 ? cards.length - 1 : currentImageIndex - 1;
        openLightbox(currentImageIndex);
      }

      function showNextImage() {
        currentImageIndex = currentImageIndex === cards.length - 1 ? 0 : currentImageIndex + 1;
        openLightbox(currentImageIndex);
      }

      let lastFocusedCard = null;

      memoryCards.forEach((card, index) => {
        card.addEventListener('click', (e) => {
          e.preventDefault();
          lastFocusedCard = card;
          openLightbox(index);
        });
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            lastFocusedCard = card;
            openLightbox(index);
          }
        });
      });

      if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
      if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);
      if (lightboxPrev) lightboxPrev.addEventListener('click', showPrevImage);
      if (lightboxNext) lightboxNext.addEventListener('click', showNextImage);

      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('active')) return;
        switch(e.key) {
          case 'Escape': closeLightbox(); break;
          case 'ArrowLeft': showPrevImage(); break;
          case 'ArrowRight': showNextImage(); break;
        }
      });

      let startX = 0;
      lightbox.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; });
      lightbox.addEventListener('touchend', (e) => {
        const diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          diff > 0 ? showNextImage() : showPrevImage();
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initLightbox);
  </script>
</BaseLayout>

<style>
  .memories-page {
    padding: var(--section-padding) 0;
    background: var(--gradient-primary);
    min-height: 80vh;
    position: relative;
  }

  .memories-page::before {
    z-index: 0;
  }


  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 600;
    color: white;
    margin: 0 0 16px 0;
    text-transform: uppercase;
    letter-spacing: 4px;
  }

  .title-accent {
    width: 60px;
    height: 3px;
    background: var(--gradient-card-border);
    margin: 0 auto;
    border-radius: 2px;
  }

  .memories-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    justify-items: center;
    gap: 24px;
    margin-bottom: 40px;
  }

  .memory-card {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
    cursor: pointer;
    position: relative;
    content-visibility: auto;
    contain-intrinsic-size: 350px 350px;
  }

  .memory-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 17px;
    background: var(--gradient-card-border);
    z-index: -1;
    opacity: 0;
    transition: opacity var(--transition-medium);
  }

  .memory-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }

  .memory-card:hover::before {
    opacity: 1;
  }

  .memory-card:hover .overlay,
  .memory-card:focus-visible .overlay {
    opacity: 1;
  }

  .memory-card:focus-visible {
    outline: 3px solid var(--color-electric-light);
    outline-offset: 2px;
  }

  .memory-image-wrapper {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(30, 42, 120, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-medium);
    pointer-events: none;
  }

  .zoom-icon {
    background: rgba(30, 42, 120, 0.7);
    border-radius: 50%;
    padding: 10px;
    width: 44px;
    height: 44px;
  }

  .memory-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
  }

  .lightbox.active { display: block; }

  .lightbox-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.95);
  }

  .lightbox-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .lightbox-content {
    max-width: 90vw;
    max-height: 90vh;
    position: relative;
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 12px;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 30px;
    font-size: 40px;
    color: white;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1001;
    transition: transform var(--transition-fast);
  }

  .lightbox-close:hover { transform: scale(1.2); }
  .lightbox-close:focus-visible { outline: 2px solid var(--color-electric-light); outline-offset: 4px; }

  .lightbox-prev, .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 60px;
    color: white;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1001;
    padding: 20px;
    transition: transform var(--transition-fast);
  }

  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }
  .lightbox-prev:hover { transform: translateY(-50%) scale(1.2); }
  .lightbox-next:hover { transform: translateY(-50%) scale(1.2); }
  .lightbox-prev:focus-visible,
  .lightbox-next:focus-visible { outline: 2px solid var(--color-electric-light); outline-offset: 4px; }

  .lightbox-info {
    text-align: center;
    color: white;
    margin-top: 12px;
    font-family: var(--font-body);
  }

  .lightbox-counter {
    font-size: 14px;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .memories-page { padding: var(--section-padding-mobile) 0; }
    .section-title { font-size: 36px; }
    .memories-gallery {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .memories-page { padding: 40px 0; }
    .section-title { font-size: 28px; }
  }
</style>
